{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktreader.org/schema/adapter-identity-1.0.0.json",
  "title": "AKTREADER LoRA adapter identity",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "adapter_id",
    "base_model",
    "training_export",
    "training_recipe",
    "trainer_runtime",
    "adapter",
    "verification"
  ],
  "properties": {
    "$schema": {"const": "../schemas/adapter-identity-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "base_model": {"$ref": "#/$defs/pin"},
    "training_export": {"$ref": "#/$defs/pin"},
    "training_recipe": {"$ref": "#/$defs/pin"},
    "trainer_runtime": {
      "type": "object",
      "required": ["implementation", "version", "container_image_digest"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "container_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "adapter": {"$ref": "#/$defs/pin"},
    "verification": {
      "type": "object",
      "required": [
        "base_model_sha256_match",
        "adapter_sha256_match",
        "load_test",
        "held_out_probe",
        "verified_at"
      ],
      "properties": {
        "base_model_sha256_match": {"const": true},
        "adapter_sha256_match": {"const": true},
        "load_test": {"const": "PASS"},
        "held_out_probe": {"enum": ["PASS", "FAIL"]},
        "verified_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
