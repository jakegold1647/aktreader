{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktreader.org/schema/adjudication-wave-1.0.0.json",
  "title": "AKTREADER adjudication wave",
  "type": "object",
  "required": ["$schema", "schema_version", "wave_id", "title", "questions", "exemplar_catalog"],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "adjudication-wave-1\\.0\\.0\\.schema\\.json$"
    },
    "schema_version": {"const": "1.0.0"},
    "wave_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "title": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "exemplar_catalog": {
      "type": "array",
      "items": {"$ref": "#/$defs/exemplar"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height", "coordinate_space"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "coordinate_space": {"const": "source_pixels"}
      },
      "additionalProperties": false
    },
    "imageRegion": {
      "type": "object",
      "required": ["path", "sha256", "bbox"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "glyph_bbox": {"$ref": "#/$defs/bbox"},
        "character_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "label", "value", "glyph", "consequence"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": {"type": "string", "minLength": 1},
        "value": {},
        "glyph": {"type": "string", "minLength": 1, "maxLength": 4},
        "consequence": {"type": "string", "minLength": 1},
        "effect": {"enum": ["ATTEST_FIELD", "ROUTE_EXPERT"]},
        "benchmark_eligible": {"type": "boolean"},
        "correction_eligible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["label", "plain_text", "artifact"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "plain_text": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/imageRegion"}
      },
      "additionalProperties": false
    },
    "structuralCheck": {
      "type": "object",
      "required": ["label", "result", "interpretation"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "result": {"enum": ["SUPPORTS", "CONTRADICTS", "NEUTRAL"]},
        "interpretation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "comparisonEvidence": {
      "type": "object",
      "required": ["evidence_id", "label", "plain_text", "artifact"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": {"type": "string", "minLength": 1},
        "plain_text": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/imageRegion"}
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "question_id",
        "record_id",
        "record_sha256",
        "field_path",
        "clerk_year_id",
        "selection_reason",
        "claim",
        "question",
        "artifact",
        "candidates",
        "bilingual_anchors",
        "structural_checks",
        "neither_consequence",
        "cant_tell_consequence"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "record_id": {"type": "string", "minLength": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "field_path": {"type": "string", "minLength": 1},
        "clerk_year_id": {"type": "string", "minLength": 1},
        "review_mode": {
          "enum": ["LETTERFORM_CHOICE", "VISUAL_CORROBORATION"]
        },
        "selection_reason": {
          "enum": [
            "IDENTITY_FORK",
            "MACHINE_DEADLOCK",
            "CORROBORATION_CONFLICT",
            "GOLD_SINGLE_COVERAGE",
            "EXCLUDE_TRANSCRIPTION_QUEUE"
          ]
        },
        "claim": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
"artifact": {
          "allOf": [
            {"$ref": "#/$defs/imageRegion"},
            {"required": ["glyph_bbox"]}
          ]
        },
        "magnification": {"type": "integer", "minimum": 4, "maximum": 8},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "comparison_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/comparisonEvidence"}
        },
        "bilingual_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        },
        "structural_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/structuralCheck"}
        },
        "neither_consequence": {"type": "string", "minLength": 1},
        "cant_tell_consequence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_mode": {"const": "VISUAL_CORROBORATION"}
            },
            "required": ["review_mode"]
          },
          "then": {
            "required": ["comparison_evidence"]
          }
        }
      ]
    },
    "exemplar": {
      "type": "object",
      "required": [
        "exemplar_id",
        "clerk_year_id",
        "glyph",
        "label",
        "text",
        "confidence",
        "artifact"
      ],
      "properties": {
        "exemplar_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "clerk_year_id": {"type": "string", "minLength": 1},
        "glyph": {"type": "string", "minLength": 1, "maxLength": 4},
        "label": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "confidence": {"const": "UNCONTESTED"},
        "artifact": {"$ref": "#/$defs/imageRegion"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
